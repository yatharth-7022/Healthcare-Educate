// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  password     String
  refreshToken String?
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Stripe payment relationships
  subscriptions Subscription[]
  payments      Payment[]

  // Practice progress relationships
  questionProgressEntries PracticeQuestionProgress[]
  questionReports         PracticeQuestionReport[]
  practiceAttempts        PracticeAttempt[]
}

model Subscriber {
  id    Int    @id @default(autoincrement())
  email String @unique
}

model Subscription {
  id                   Int      @id @default(autoincrement())
  
  // Link to your User
  userId               Int
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  stripeCustomerId     String   // Links to Stripe Customer (e.g., "cus_ABC123")
  stripeSubscriptionId String   @unique // Links to Stripe Subscription (e.g., "sub_XYZ789")
  stripePriceId        String   // Which plan they're on (e.g., "price_1ABC...")

  status               String
  
  currentPeriodStart   DateTime // When current billing period started
  currentPeriodEnd     DateTime // When it ends (renewal date)
  
  // Cancellation tracking
  cancelAtPeriodEnd    Boolean  @default(false) // True = user requested cancel, will end at period end
  
  // Timestamps
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  // Indexes for fast lookups
  @@index([userId])
  @@index([stripeCustomerId])
  @@index([status])
}

// STRIPE PAYMENT MODEL
// Historical record of all payment transactions
model Payment {
  id              Int      @id @default(autoincrement())
  
  // Link to your User
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Stripe Payment ID (for reference/refunds)
  stripePaymentId String   @unique // Payment Intent ID or Invoice ID
  
  // Payment details
  amount          Int      // Amount in cents (e.g., 2999 = $29.99)
  currency        String   @default("usd") // ISO currency code
  
  // Payment status
  // Values: "succeeded", "pending", "failed", "refunded"
  status          String
  
  // Description (what was purchased)
  description     String?
  
  // Timestamp
  createdAt       DateTime @default(now())
  
  // Indexes for fast lookups
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model PracticeCategory {
  id            String   @id
  name          String
  displayOrder  Int
  totalQuestions Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subcategories PracticeSubcategory[]
  questionSets  PracticeQuestionSet[]

  @@index([displayOrder])
}

model PracticeSubcategory {
  id             String   @id
  categoryId     String
  name           String
  displayOrder   Int
  totalQuestions Int
  comingSoon     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category        PracticeCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  questionProgress PracticeQuestionProgress[]
  questionSets     PracticeQuestionSet[]
  attempts         PracticeAttempt[]

  @@index([categoryId, displayOrder])
}

model PracticeQuestionProgress {
  id             Int      @id @default(autoincrement())
  userId         Int
  subcategoryId  String
  questionKey    String
  isCorrect      Boolean
  selectedOptionIndex Int?
  attemptCount   Int      @default(1)
  firstAnsweredAt DateTime @default(now())
  lastAnsweredAt DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subcategory PracticeSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@unique([userId, subcategoryId, questionKey])
  @@index([userId, subcategoryId])
}

enum PracticeAttemptStatus {
  IN_PROGRESS
  COMPLETED
}

// One run through a practice session. Question sets are frozen at start so the
// attempt can be resumed/reviewed even if new sets are published later.
model PracticeAttempt {
  id                   Int                   @id @default(autoincrement())
  userId               Int
  categoryId           String
  subcategoryId        String
  questionSetIds       Int[]
  totalQuestions       Int
  status               PracticeAttemptStatus @default(IN_PROGRESS)
  currentQuestionIndex Int                   @default(0)
  bookmarkedKeys       String[]
  startedAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  completedAt          DateTime?

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subcategory PracticeSubcategory     @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  answers     PracticeAttemptAnswer[]

  @@index([userId, updatedAt])
  @@index([userId, subcategoryId, status])
}

model PracticeAttemptAnswer {
  id                  Int      @id @default(autoincrement())
  attemptId           Int
  questionKey         String
  selectedOptionIndex Int
  isCorrect           Boolean
  answeredAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt

  attempt PracticeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionKey])
}

model PracticeQuestionReport {
  id            Int      @id @default(autoincrement())
  userId        Int
  categoryId    String
  subcategoryId String
  questionSetId Int
  questionId    String
  message       String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionSetId, questionId])
  @@index([userId])
}

model PracticeQuestionSet {
  id            Int      @id @default(autoincrement())
  categoryId    String
  subcategoryId String
  title         String
  stem          Json
  questions     Json
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category    PracticeCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory PracticeSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, subcategoryId, isPublished])
}